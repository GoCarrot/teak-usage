#!/bin/bash
# Wrapper around teak-hq's canonical script/set_worktree_identity. A symlink would
# be simpler, but Antora walks this repo from its root and dies on a dangling link
# (CI and docs.teak.io clone it without teak-hq beside it). script/worktree finds
# this file via $(dirname "$0"), so it has to live here.
exec "$(dirname "$0")/../../../script/set_worktree_identity" "$@"
